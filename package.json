{
  "name": "padishah-brooklyn-review-site",
  "version": "0.1.0",
  "private": true,
  "description": "Private review build for Padishah Restaurant (1920 Avenue U, Brooklyn, NY). Review mode by default — not production-cleared.",
  "scripts": {
    "content": "node scripts/build-content.mjs",
    "media": "node scripts/build-media.mjs",
    "prebuild": "node scripts/build-content.mjs && node scripts/check-production-gate.mjs",
    "dev": "node scripts/build-content.mjs && next dev -p 4480",
    "build": "next build",
    "build:sites": "node scripts/build-content.mjs && vinext build && node scripts/check-production-gate.mjs --output",
    "postbuild": "node scripts/check-production-gate.mjs --output",
    "start": "next start -p 4480",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "gsap": "^3.13.0",
    "next": "16.2.12",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "three": "^0.181.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@openai/sites-vite-plugin": "0.1.0",
    "@types/node": "^22.15.3",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.181.0",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "react-server-dom-webpack": "19.2.6",
    "typescript": "^5.8.3",
    "vinext": "1.0.0-beta.2",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
